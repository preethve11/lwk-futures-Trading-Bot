# VPS deployment environment template.
# Copy into a private environment source or secret manager. Do not commit real values.

APP_ENV=production
API_TOKEN=
API_CORS_ORIGINS=["https://dashboard.example.com"]

DATABASE_URL=postgresql+psycopg://trading_bot:change-me@postgres:5432/trading_bot
REDIS_URL=redis://redis:6379/0

USE_TESTNET=true
CONFIRM_LIVE_TRADING=false
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
BINANCE_MAINNET_API_KEY=
BINANCE_MAINNET_API_SECRET=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

METRICS_ENABLED=true
METRICS_INCLUDE_DATABASE=true
METRICS_TOKEN=
READINESS_CHECK_DATABASE=true

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

OPENAI_API_KEY=
AI_JOURNAL_ENABLED=false
AI_JOURNAL_MODEL=gpt-4.1-mini

