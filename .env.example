# =============================================================================
# LOCAL ONLY — Copy to .env and fill in. NEVER commit .env to Git (it's in .gitignore).
# This file is safe to commit; it contains no secrets.
# =============================================================================

# --- Binance Futures API (choose one of the two options below) ---

# Option 1: Single set of keys (swap these when switching testnet vs live)
# BINANCE_API_KEY=your_api_key_here
# BINANCE_API_SECRET=your_api_secret_here

# Option 2 (recommended): Separate keys — keep both and switch with USE_TESTNET only
# Testnet: create at https://testnet.binancefuture.com (demo trading, no real money)
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Mainnet: create at Binance → API Management → Enable USDT-M Futures (real money)
BINANCE_MAINNET_API_KEY=
BINANCE_MAINNET_API_SECRET=

# true = use testnet (demo), false = use mainnet (live). Ignored if using Option 1.
USE_TESTNET=true
# Required only when USE_TESTNET=false. Keep false unless intentionally trading real funds.
CONFIRM_LIVE_TRADING=false

# --- Symbol and timeframe ---
STRATEGY_NAME=ema_rsi_vwap
SYMBOL=ZECUSDT
SYMBOLS=ZECUSDT,BTCUSDT,ETHUSDT
TIMEFRAME=5m

# --- Execution ---
LEVERAGE=5

# --- Risk (optional overrides; also in config.yaml) ---
RISK_PER_TRADE_USD=10
MAX_DAILY_LOSS_USD=50

# --- Strategy overrides (optional) ---
# EMA_FAST=9
# EMA_SLOW=21
# RSI_LEN=7
# ATR_LEN=14
# ATR_STOP_MULT=0.8
# ATR_TP_MULT=1.6
# VOL_MULT=1.5
# VWAP_WINDOW=0
# RSI_LONG_MIN=48
# RSI_SHORT_MAX=52
# COOLDOWN_CANDLES=1

# --- Telegram (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Logging ---
# LOG_LEVEL=INFO

# --- API ---
# Required when exposing the FastAPI backend outside local development.
API_TOKEN=
# JSON array of browser origins allowed to call the API.
API_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173","http://127.0.0.1:8080","http://localhost:8080"]

# --- Persistence ---
# Defaults to a local SQLite database ignored by Git.
# DATABASE_URL=sqlite:///./trading_bot.db
# Compose uses Postgres:
# DATABASE_URL=postgresql+psycopg://trading_bot:trading_bot@postgres:5432/trading_bot
REDIS_URL=redis://localhost:6379/0

# --- Market Data ---
# rest = live strategy loop polls Binance REST.
# redis = live strategy loop consumes klines from Redis, populated by `python main.py market-data`.
MARKET_DATA_SOURCE=rest
MARKET_DATA_CHANNEL=market_data.kline
MARKET_DATA_HISTORY_SIZE=500
MARKET_DATA_RECONNECT_BACKOFF_SECONDS=2

# --- Backtesting reports ---
# HISTORICAL_DATA_DIR=data
# BACKTEST_REPORT_DIR=reports/backtests

# --- Walk-forward optimization ---
WALK_FORWARD_TRAIN_SIZE=500
WALK_FORWARD_VALIDATION_SIZE=100
WALK_FORWARD_STEP_SIZE=100
WALK_FORWARD_TRIALS=30
WALK_FORWARD_OBJECTIVE=sharpe
WALK_FORWARD_RANDOM_SEED=42
WALK_FORWARD_REPORT_DIR=reports/optimizations

# --- Monte Carlo simulation ---
MONTE_CARLO_SIMULATIONS=1000
MONTE_CARLO_HORIZON_TRADES=100
MONTE_CARLO_RUIN_DRAWDOWN_PCT=30
MONTE_CARLO_RANDOM_SEED=42
MONTE_CARLO_REPORT_DIR=reports/monte_carlo

# --- AI Trade Journal ---
# Advisory only. Never gives the AI permission to place orders or mutate trading state.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_JOURNAL_ENABLED=false
AI_JOURNAL_MODEL=gpt-4.1-mini
AI_JOURNAL_TIMEOUT_SECONDS=15
AI_JOURNAL_MAX_QUEUE_SIZE=1000
